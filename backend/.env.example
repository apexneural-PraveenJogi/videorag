# --- Required for Q&A ---
# A single OpenRouter key powers BOTH the vision model (answers) and embeddings
# (OpenRouter serves an OpenAI-compatible /embeddings route).
OPENROUTER_API_KEY=
DEFAULT_VISION_MODEL=openai/gpt-4o-mini

# --- Embeddings (required for indexing/retrieval) ---
# Reuses the OpenRouter key by default (EMBEDDING_API_KEY blank → falls back to
# OPENROUTER_API_KEY). Override only if you want a different embeddings host.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=

# --- Video processing ---
FRAME_EXTRACT_FPS=1
FRAME_FORMAT=jpg
WHISPER_MODEL=base
MAX_VIDEO_SIZE_MB=500

# --- Storage / vector store ---
STORAGE_DIR=./storage
CHROMA_PERSIST_DIR=./chroma_db

# --- CORS (frontend origin) ---
CORS_ORIGINS=http://localhost:5173
